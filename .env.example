POSTGRES_USER=bankadmin
POSTGRES_PASSWORD=replace-me
JWT_ALGORITHM=RS256
JWT_ISSUER=bankcore-auth
JWT_AUDIENCE=bankcore-api
JWT_ACTIVE_KID=bankcore-2026-01
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEYS_HOST_DIR=./secrets/jwt-public
AUTH_SERVICE_TOKEN=replace-me-with-a-long-random-service-token
RATE_LIMIT_KEY_SECRET=replace-me-with-a-separate-long-random-rate-limit-secret
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=1.0
REDIS_MAXMEMORY=64mb
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_TOKEN_EXPIRE_SECONDS=60
# Enable only for an explicitly local/demo deployment. Keep false elsewhere.
DEMO_MODE=false
GATEWAY_PORT=80
AUTH_SERVICE_URL=http://auth-service:8000
